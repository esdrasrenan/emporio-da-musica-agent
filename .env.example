# Copy this file to .env and fill in your key.

# --- LLM provider -----------------------------------------------------------
# "anthropic" (default) or "openai" (any OpenAI-compatible endpoint:
# OpenAI, Google Gemini, Groq, OpenRouter, a local Ollama...).
LLM_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Only for organization-wide keys not tied to a workspace (the API answers
# "must include the anthropic-workspace-id header"): the workspace to bill.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional overrides (defaults are documented in the README).
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=medium

# OpenAI-compatible providers (only when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Runtime ------------------------------------------------------------------
# SQLite file for conversation history and support tickets.
# EMPORIO_DB_PATH=.data/emporio.sqlite3

# Freeze the agent's clock (ISO 8601, America/Campo_Grande). Useful because the
# dataset is a snapshot from March 2026; see "Assumptions" in the README.
# EMPORIO_NOW=2026-03-24T10:30:00
